# Leave these empty locally so the API inherits the page hostname. This keeps
# localhost with localhost (or 127.0.0.1 with 127.0.0.1) for SameSite cookies.
# Staging/production should prefer /api and leave VITE_WS_BASE_URL empty
# so HTTP and WebSocket traffic share the frontend origin.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
